# Copy this file to .env and fill it in. Never share or commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
PORT=5000
# Websites allowed to use the chatbot (comma separated). Leave empty while testing.
ALLOWED_ORIGINS=https://www.nebulaa.org,https://nebulaa.org
# Optional: every enquiry is also POSTed here (Google Apps Script, Make, Zapier, Slack...)
ENQUIRY_WEBHOOK_URL=

# ---- WhatsApp (optional, see setup steps) ----
WHATSAPP_NUMBER=            # your WhatsApp number with country code, digits only, e.g. 919865577224 (adds a "Chat on WhatsApp" button)
WHATSAPP_VERIFY_TOKEN=      # any secret word you choose; paste the same word in Meta's webhook settings
WHATSAPP_TOKEN=             # permanent access token from Meta
WHATSAPP_PHONE_ID=          # Phone number ID from Meta
WHATSAPP_APP_SECRET=        # App secret from Meta (verifies messages really come from WhatsApp)
